# Hugging Face token with access to pyannote/speaker-diarization-community-1
# Create at https://hf.co/settings/tokens
# Accept model terms at https://hf.co/pyannote/speaker-diarization-community-1
HF_TOKEN=hf_xxx

# Forever extract-worker (local)
FOREVER_API_URL=http://127.0.0.1:8001
EXTRACT_WORKER_TOKEN=forever-extract-worker
EXTRACT_POLL_SECONDS=3
