# Copy to deploy/.env.prod on the VM and fill secrets. Never commit .env.prod.

# Postgres — same server as Angi, separate database + role (created once on VM)
FOREVER_DB_USER=forever
FOREVER_DB_NAME=forever
FOREVER_DB_PASSWORD=change-me-strong-db-password

# CORS — Expo web + native (native apps usually omit Origin)
CORS_ORIGINS=https://forever-api.antunai.com,http://localhost:8081,http://localhost:19006

SEED_DEMO=false

# Auth — Firebase email/password only. Dev login mints its own JWT and creates
# users on demand, so leaving it on in production is an open door.
AUTH_DEV_MODE=false
AUTH_DEV_SECRET=
FIREBASE_PROJECT_ID=forever-70614
FIREBASE_CREDENTIALS_JSON=/run/secrets/firebase.json

# Heritage agent (Gemini)
AGENT_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Voice DNA providers
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_LANGUAGE_CODE=vi
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-hd
VOICE_DEFAULT_PROVIDER=elevenlabs

# Extract worker — strong shared secret + Hugging Face token (pyannote model terms)
EXTRACT_WORKER_TOKEN=change-me-extract-worker-token
EXTRACT_JOB_STALE_MINUTES=60
EXTRACT_POLL_SECONDS=3
HF_TOKEN=

# Image tags (local build default)
API_IMAGE=forever-api:latest
EXTRACT_WORKER_IMAGE=forever-extract-worker:latest
