DATABASE_URL=postgresql+psycopg://forever:forever@localhost:5434/forever
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
SEED_DEMO=true
AUTH_DEV_MODE=true
# Required whenever AUTH_DEV_MODE=true — the API refuses to boot on the
# placeholder, because a known secret lets anyone mint a session for any email.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
AUTH_DEV_SECRET=
# Production: set FIREBASE_PROJECT_ID + service account JSON (string or path).
# Dev login remains available while AUTH_DEV_MODE=true (even if Firebase is on).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
AGENT_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# STT only — cheaper Lite; compose/analyzer keep GEMINI_MODEL.
STT_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Shared ElevenLabs key for local Voice DNA. Space-level key in Cài đặt can come later.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_LANGUAGE_CODE=vi
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.9
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEED=0.9
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_REMOVE_NOISE=true
ELEVENLABS_LENGTHEN_PAUSES=true
# Local Extract worker (claim/complete). Keep in sync with extract-worker env.
EXTRACT_WORKER_TOKEN=forever-extract-worker
# Re-queue running jobs after N minutes without worker progress (default 60).
EXTRACT_JOB_STALE_MINUTES=60

# Sentry forever-api — Project Settings → Client Keys (DSN). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2
