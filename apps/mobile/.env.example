EXPO_PUBLIC_API_URL=http://localhost:8001
# dev build → home screen "Forever (Dev)" + bundle id …forever.dev
# production release: APP_VARIANT=production npm run android:apk
APP_VARIANT=dev
# Family APK: use your Mac LAN IP (same Wi‑Fi) or a public HTTPS URL, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8001
EXPO_PUBLIC_AUTH_DEV=true
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDS9CTQu0rUrhXkqqH1BoLEBm7sl7jBAl8
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=forever-70614.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=forever-70614
EXPO_PUBLIC_FIREBASE_APP_ID=1:787275064281:web:993de324a0e8e945c5afc8
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=787275064281
# Firebase Console → Authentication → Sign-in method → Google → Web client ID
# (…apps.googleusercontent.com). Bắt buộc cho Google Sign-In native.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS native: Firebase → Project settings → iOS app → hoặc Google Cloud → iOS OAuth client
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
