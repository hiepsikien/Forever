EXPO_PUBLIC_API_URL=http://localhost:8001
# dev build → home screen "Forever (Dev)" + bundle id …forever.dev
# family/production release: APP_VARIANT=production npm run android:apk
APP_VARIANT=dev
# Family APK: Mac LAN IP (same Wi‑Fi) or the shared HTTPS API, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8001
# EXPO_PUBLIC_API_URL=https://forever-api.antunai.com

# Local dev only — family builds sign in with Firebase email/password.
EXPO_PUBLIC_AUTH_DEV=true
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDS9CTQu0rUrhXkqqH1BoLEBm7sl7jBAl8
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=forever-70614.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=forever-70614
EXPO_PUBLIC_FIREBASE_APP_ID=1:787275064281:web:993de324a0e8e945c5afc8
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=787275064281

# Sentry (forever-mobile). DSN is public; auth token is secret (upload sourcemaps).
# Client → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXX.ingest.us.sentry.io/YOUR_PROJECT_ID
# Org slug from the Sentry URL / settings (not the display name)
SENTRY_ORG=YOUR_ORG_SLUG
SENTRY_PROJECT=forever-mobile
# Settings → Auth Tokens → Organization Token, scope project:releases (+ org:read)
# Required for release builds that upload source maps (android:apk / ios:prod).
# Local: keep in .env / .env.family only (gitignored).
# EAS cloud: eas secret:create --name SENTRY_AUTH_TOKEN --scope project
#   — never put the real token in eas.json.
# Local Metro can leave this empty; set SENTRY_DISABLE_AUTO_UPLOAD=true to silence warnings.
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
