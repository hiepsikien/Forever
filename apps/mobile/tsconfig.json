{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // SDK 58 / RN 0.87 default to Strict TypeScript API. Keep the legacy
    // deep-import types until Forever migrates refs (ViewInstance, etc.).
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "paths": {
      "@/*": ["./*"],
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/rn/index.rn.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
