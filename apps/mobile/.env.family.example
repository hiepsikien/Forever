# Copy to apps/mobile/.env.family, then:
#   FOREVER_ENV_FILE=.env.family npm run android:apk
#
# Keeps the family build separate from .env, which stays pointed at localhost
# for day-to-day development.

APP_VARIANT=production
EXPO_PUBLIC_API_URL=https://forever-api.antunai.com

# Firebase email/password is the only way in. No dev login on family phones.
EXPO_PUBLIC_AUTH_DEV=false
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDS9CTQu0rUrhXkqqH1BoLEBm7sl7jBAl8
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=forever-70614.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=forever-70614
EXPO_PUBLIC_FIREBASE_APP_ID=1:787275064281:web:993de324a0e8e945c5afc8
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=787275064281

# Sentry forever-mobile — same values as apps/mobile/.env
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXX.ingest.us.sentry.io/YOUR_PROJECT_ID
SENTRY_ORG=YOUR_ORG_SLUG
SENTRY_PROJECT=forever-mobile
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
