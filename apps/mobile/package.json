{
  "name": "forever-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "APP_VARIANT=dev expo run:android",
    "ios": "APP_VARIANT=dev expo run:ios",
    "ios:build": "bash scripts/build-ios-dev.sh",
    "ios:prod": "bash scripts/build-ios-prod.sh",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "android:keystore": "bash scripts/ensure-keystore.sh",
    "android:apk": "bash scripts/build-apk.sh",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@forever/api-client": "file:../../packages/api-client",
    "@forever/philosophy": "file:../../packages/philosophy",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@sentry/react-native": "~8.28.0",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-auth-session": "~58.0.13",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-media-library": "~58.0.11",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "firebase": "^12.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
