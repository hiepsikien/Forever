{
  "name": "forever",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "api:test": "cd apps/api && .venv/bin/pytest -q",
    "dev:api": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "dev:mobile": "npm --prefix apps/mobile start"
  }
}
